{
    "compilerOptions": {
        "target": "ES2023",
        "module": "Preserve",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "types": ["bun-types"],
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
